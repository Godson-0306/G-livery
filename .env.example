# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Postgres — Neon in production. Local: `npx prisma dev` or docker-compose.yml
DATABASE_URL="postgresql://gelivery:gelivery@localhost:5433/gelivery"
DIRECT_URL="postgresql://gelivery:gelivery@localhost:5433/gelivery"

# Seed accounts (optional overrides)
SEED_ADMIN_EMAIL="admin@g-livery.app"
SEED_ADMIN_PASSWORD="Admin123!"

# Cloudinary (menu photos / logos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Flutterwave (runner subscriptions only)
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""

# Runner subscription pricing (NGN)
SUBSCRIPTION_AMOUNT_NGN="5000"
SUBSCRIPTION_DAYS="30"
